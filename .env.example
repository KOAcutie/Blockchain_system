# ==============================================================================
# SSC Transparency — Root Environment Template (.env.example)
# ==============================================================================

# 1. Next.js Frontend (web/.env.local)
NEXT_PUBLIC_API_URL=http://localhost:8000/api

# 2. Laravel Primary Backend (backend/.env)
APP_NAME="SSC Transparency"
APP_ENV=local
APP_DEBUG=true
APP_URL=http://localhost:8000
FRONTEND_URL=http://localhost:3000

DB_CONNECTION=sqlite
# For PostgreSQL:
# DB_CONNECTION=pgsql
# DB_HOST=127.0.0.1
# DB_PORT=5432
# DB_DATABASE=ssc_transparency
# DB_USERNAME=postgres
# DB_PASSWORD=postgres

BLOCKCHAIN_SERVICE_URL=http://localhost:8001
BLOCKCHAIN_SERVICE_KEY=ssc-internal-service-secret-2026

# 3. Python FastAPI Blockchain Service (blockchain-api/.env)
PORT=8001
BLOCKCHAIN_RPC_URL=http://127.0.0.1:8545
BLOCKCHAIN_CHAIN_ID=31337
BLOCKCHAIN_PRIVATE_KEY=
BLOCKCHAIN_CONTRACT_ADDRESS=0x5FbDB2315678afecb367f032d93F642f64180aa3
LARAVEL_SERVICE_KEY=ssc-internal-service-secret-2026

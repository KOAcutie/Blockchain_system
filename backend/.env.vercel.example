# Add these values in the Vercel project's Environment Variables settings.
# Runtime defaults (production, stderr logging, cookie sessions, sync queue,
# array cache, S3 filesystem) are already provided by vercel.json.
APP_NAME="SSC Transparency"
APP_KEY=
APP_URL=https://your-backend.vercel.app
CORS_ALLOWED_ORIGINS=https://your-frontend.vercel.app

# Persistent external PostgreSQL database (for example Neon or Supabase).
DB_CONNECTION=pgsql
DB_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require
DB_SSLMODE=require

# Private S3-compatible bucket for payment proofs (AWS S3, R2, etc.).
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
# Set for an S3-compatible provider; omit for AWS S3.
AWS_ENDPOINT=
AWS_USE_PATH_STYLE_ENDPOINT=false

# Separately deployed Python FastAPI service.
PYTHON_BLOCKCHAIN_API_URL=https://your-blockchain-service.example.com
PYTHON_BLOCKCHAIN_SERVICE_KEY=
BLOCKCHAIN_NETWORK=sepolia
BLOCKCHAIN_CONTRACT_ADDRESS=0x4a2f3977cd48FF6D04B0069d58dCAfd45e852856
BLOCKCHAIN_RPC_URL=https://your-sepolia-rpc.example.com
